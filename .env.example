# Copy to .env and change every password: cp .env.example .env
# .env is git-ignored. Avoid quotes, spaces and @ in passwords (they break connect strings).

ORACLE_PASSWORD=ChangeMe_Sys1
ORACLE_APP_PASSWORD=ChangeMe_Shop1

MARIADB_ROOT_PASSWORD=ChangeMe_Root1
MARIADB_APP_PASSWORD=ChangeMe_Shop1
MARIADB_REPL_PASSWORD=ChangeMe_Repl1

POSTGRES_PASSWORD=ChangeMe_Pg1

# MongoDB administrator (dbops_admin, created by engines/mongo/init-replica-set.js) (M5)
MONGO_ADMIN_PASSWORD=ChangeMe_MongoAdm1

# shop_app: the application's least-privilege account, the same name in every engine (M5)
APP_PASSWORD=ChangeMe_App1

# Read-only monitoring account used by `dbops health` (M2), one per engine
MONITOR_PASSWORD=ChangeMe_Mon1

# Host ports. Change one if something on your machine already listens there.
ORACLE_PORT=1521
MARIADB_PRIMARY_PORT=3316
MARIADB_REPLICA_PORT=3317
MONGO1_PORT=27017
MONGO2_PORT=27018
MONGO3_PORT=27019
PG_PORT=5442
