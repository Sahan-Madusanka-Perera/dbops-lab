# Copy to .env and change every password: cp .env.example .env
# .env is git-ignored. Avoid quotes, spaces and @ in passwords (they break connect strings).

ORACLE_PASSWORD=ChangeMe_Sys1
ORACLE_APP_PASSWORD=ChangeMe_Shop1

MARIADB_ROOT_PASSWORD=ChangeMe_Root1
MARIADB_APP_PASSWORD=ChangeMe_Shop1
MARIADB_REPL_PASSWORD=ChangeMe_Repl1

POSTGRES_PASSWORD=ChangeMe_Pg1

# Host ports. Change one if something on your machine already listens there.
ORACLE_PORT=1521
MARIADB_PRIMARY_PORT=3306
MARIADB_REPLICA_PORT=3307
MONGO1_PORT=27017
MONGO2_PORT=27018
MONGO3_PORT=27019
