# Local secrets: copy .env.example to .env
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Backups are produced by the lab, never committed (M3)
backups/

# Ansible: collections from requirements.yml, the dbops wheel built for the hosts (M6)
ansible/*.retry
ansible/collections/
build/

# Terraform: providers and state (the state lists every resource; never commit it)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*

.DS_Store
*.egg-info/

# dbops local state (slow --reset markers)
.dbops/

# Generated secrets: MongoDB keyfile (M5), the Ansible SSH key and known_hosts (M6)
secrets/
