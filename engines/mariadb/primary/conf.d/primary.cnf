[mariadb]
server_id              = 1

# Binary log + GTID: required for the replica, and for point-in-time recovery (M3)
log_bin                = mariadb-bin
binlog_format          = ROW
gtid_strict_mode       = ON
log_slave_updates      = ON
binlog_expire_logs_seconds = 259200   # 3 days

# Slow query log, read by `dbops slow` (M4)
slow_query_log                  = ON
slow_query_log_file             = /var/lib/mysql/slow.log
log_slow_query_time             = 0.5
# Also log any statement that reads 1,000+ rows without an index: on a small
# table that is fast today and slow once the table grows.
log_queries_not_using_indexes   = ON
log_slow_min_examined_row_limit = 1000
log_slow_verbosity              = query_plan
